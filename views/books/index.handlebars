<section class="card">
  <h1>Danh sách sách</h1>
  <a class="button" href="/books/add">Thêm sách mới</a>

  {{#if success}}
    <p class="success">Đã thêm sách thành công.</p>
  {{/if}}

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Mã sách</th>
          <th>Tên sách</th>
          <th>Giá gốc</th>
          <th>VAT</th>
          <th>Giá sau thuế</th>
        </tr>
      </thead>
      <tbody>
        {{#each books}}
          <tr>
            <td>{{productCode}}</td>
            <td>{{name}}</td>
            <td>{{money price}}</td>
            <td>{{vatRate}}%</td>
            <td>{{money finalPrice}}</td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5">Chưa có sách. Hãy thêm sách đầu tiên.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>